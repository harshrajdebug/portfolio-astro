---
import "../styles/term.css";
import SysHeader from "../components/SysHeader.astro";
import Boot from "../components/Boot.astro";
import Shell from "../components/Shell.astro";
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>HARSH_RAJ // SYS.PORTFOLIO</title>
<meta name="description" content="Harsh Raj tests whether systems do what they report. Fifteen findings in CNCF projects, each one a status that said one thing while the system did another.">
<meta name="theme-color" content="#0f1210">
<meta property="og:title" content="HARSH_RAJ // SYS.PORTFOLIO">
<meta property="og:description" content="Fifteen findings in CNCF projects, each one a status that said one thing while the system did another.">
<meta property="og:url" content="https://harshrajdebug.in/">
<meta property="og:type" content="website">
<meta property="og:image" content="https://harshrajdebug.in/og.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Harsh Raj -- 4 merged, 13 in review">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="https://harshrajdebug.in/og.png">
<link rel="canonical" href="https://harshrajdebug.in/">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%230f1210'/%3E%3Ctext x='5' y='22' font-family='monospace' font-size='16' fill='%234ade80'%3E%24_%3C/text%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@300;400;500&display=swap">
<script is:inline>document.documentElement.classList.add("js");</script>
</head>
<body>
<div class="crt" aria-hidden="true"></div>

<div class="shell">
{/* status bar, boot log, page slot, prompt and nav */}
  <SysHeader />
  <Boot />
  <main class="screen" id="screen">
    <slot />
    <section class="page" id="page-case" data-page="case"></section>
  </main>
  <Shell />
</div>

<noscript><p class="noscript">Harsh Raj -- harshrajdebug@gmail.com -- github.com/harshrajdebug</p></noscript>
<script src="../scripts/term.js"></script>
</body>
</html>
